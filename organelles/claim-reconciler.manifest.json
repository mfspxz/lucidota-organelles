{
  "authority": {
    "declared_valence": "candidate",
    "granted_capabilities": [],
    "mutation_class": "write",
    "required_capability": "claims.write"
  },
  "codon": "cr",
  "contracts": [
    {
      "description": "bind a store path (host-approved under an operator write root) to an unforgeable grant token; mutating ops take the token, never a raw path",
      "input_schema": {
        "additionalProperties": true,
        "properties": {
          "store_path": {
            "type": "string"
          },
          "ttl_seconds": {
            "type": "integer"
          }
        },
        "required": [
          "store_path"
        ],
        "type": "object"
      },
      "mutation_class": "write",
      "op": "open-store",
      "required_capability": "claims.write"
    },
    {
      "description": "revoke a store grant token; the token is rejected afterwards",
      "input_schema": {
        "additionalProperties": true,
        "properties": {
          "grant_token": {
            "type": "string"
          }
        },
        "required": [
          "grant_token"
        ],
        "type": "object"
      },
      "mutation_class": "write",
      "op": "close-store",
      "required_capability": "claims.write"
    },
    {
      "description": "record a fix claim; permanent ID FC-<n> assigned when absent; scope locked to INSTANCE_ONLY; provenance recorded_by the issuing grant",
      "input_schema": {
        "additionalProperties": true,
        "properties": {
          "claim_id": {
            "type": "string"
          },
          "commit": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "fix_evidence": {
            "type": "array"
          },
          "grant_token": {
            "type": "string"
          },
          "proof_script_path": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          }
        },
        "required": [
          "grant_token",
          "fix_evidence",
          "proof_script_path",
          "commit"
        ],
        "type": "object"
      },
      "mutation_class": "write",
      "op": "ingest-claim",
      "required_capability": "claims.write"
    },
    {
      "description": "record a defect; when it reproduces a claimed-fixed behavior, append a SUPERSEDED_BY_BYPASS linkage preserving the original receipt. The defeating probe must name a real artifact inside the grant-bound root whose sha256 matches payload_hash",
      "input_schema": {
        "additionalProperties": true,
        "properties": {
          "defeating_probe": {
            "type": "object"
          },
          "defeats_claim_id": {
            "type": "string"
          },
          "defect_id": {
            "type": "string"
          },
          "grant_token": {
            "type": "string"
          },
          "links": {
            "type": "array"
          },
          "reproduces_fixed_behavior": {
            "type": "boolean"
          }
        },
        "required": [
          "grant_token",
          "defect_id"
        ],
        "type": "object"
      },
      "mutation_class": "write",
      "op": "ingest-defect",
      "required_capability": "claims.write"
    },
    {
      "description": "current status of a claim (INSTANCE_ONLY / CLASS_CLOSED / SUPERSEDED_BY_BYPASS) with full event history",
      "input_schema": {
        "additionalProperties": true,
        "properties": {
          "claim_id": {
            "type": "string"
          },
          "evidence": {
            "type": "object"
          },
          "store_path": {
            "type": "string"
          }
        },
        "required": [
          "store_path",
          "claim_id"
        ],
        "type": "object"
      },
      "mutation_class": "read_only",
      "op": "claim-status"
    },
    {
      "description": "request class closure for a claim; granted only with all four evidence pieces, independent review that is not a reproducer replay, and an attesting grant different from the recording grant (self-attestation refused)",
      "input_schema": {
        "additionalProperties": true,
        "properties": {
          "claim_id": {
            "type": "string"
          },
          "evidence": {
            "type": "object"
          },
          "grant_token": {
            "type": "string"
          }
        },
        "required": [
          "grant_token",
          "claim_id"
        ],
        "type": "object"
      },
      "mutation_class": "write",
      "op": "request-class-closure",
      "required_capability": "claims.class_close"
    },
    {
      "description": "recompute the event-store hash chain and provenance checks (probe artifacts resolvable + hash-matching; no self-attested closures); reports ok or the first breaking seq",
      "input_schema": {
        "additionalProperties": true,
        "properties": {
          "store_path": {
            "type": "string"
          }
        },
        "required": [
          "store_path"
        ],
        "type": "object"
      },
      "mutation_class": "read_only",
      "op": "verify"
    }
  ],
  "description": "claim-defeat reconciliation: grant-bound store handles, permanent claim IDs, instance-only default scope, gated class closure with self-attestation refusal, hash-resolvable defeating probes, bypass-linked supersede preserving the original receipt, append-only hash-chained event store",
  "name": "claim-reconciler",
  "receipt_policy": {
    "algorithm": "sha256",
    "chain": true,
    "content_addressed": true
  },
  "schema_version": "1",
  "transports": [
    "native",
    "unix_socket",
    "mcp",
    "rest"
  ],
  "version": "1.1.0"
}
